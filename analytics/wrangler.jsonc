{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "academic-homepage-visitors",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "academic-homepage-visitors",
      "database_id": "7c6aa196-ce90-4ec0-a28a-b87238d47384"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://xiaohaoyanglei.github.io,http://127.0.0.1:4173"
  }
}
